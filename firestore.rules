rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // User scoped subcollections: businesses, customers, invoices, templates
      match /businesses/{businessId} {
        allow read, write: if isOwner(userId) && isValidId(businessId);
      }

      match /customers/{customerId} {
        allow read, write: if isOwner(userId) && isValidId(customerId);
      }

      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId) && isValidId(invoiceId);
      }

      match /templates/{templateId} {
        allow read, write: if isOwner(userId) && isValidId(templateId);
      }
    }
  }
}
