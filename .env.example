# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Public configuration loaded via firebase-applet-config.json)
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0056572639"

# Razorpay Payment Gateway Configuration (Key ID starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
